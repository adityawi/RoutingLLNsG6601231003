  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>/*
 * Contiki-NG / Cooja log script:
 *  - Mengoleksi semua output mote (msg) beserta time &amp; id
 *  - Setiap 5 menit waktu simulasi, mencetak snapshot ke log
 *  - Menghentikan script secara otomatis setelah waktu tertentu
 *
 * Catatan:
 *  - Satuan waktu: milidetik (ms)
 *  - Variabel global: time, id, msg, mote
 */

var INTERVAL = 5 * 60 * 1000;    // 5 menit = 300.000 ms
var next_dump = INTERVAL;
var buffer = "";

// Timeout manual (misal: 60 menit simulasi)
var MAX_TIME = 20000 * 60 * 1000;   // 3.600.000 ms

// Header awal di log
log.log("=== Log collector started ===\n");
log.log("Interval dump: setiap " + (INTERVAL / 60000) + " menit simulasi\n");
log.log("Akan berhenti otomatis pada " + (MAX_TIME / 60000) + " menit simulasi.\n\n");

// Loop utama
while (true) {

  // Tunggu output mote
  YIELD();

  // Simpan output ke buffer
  buffer += time + " ms | mote " + id + " | " + msg + "\n";

  // Dump snapshot setiap 5 menit
  if (time &gt;= next_dump) {
    var minutes = time / 60000.0;

    log.log("\n===== LOG SNAPSHOT @ t = " + minutes.toFixed(2) + " min =====\n");
    log.log(buffer);
    log.log("===== END SNAPSHOT =====\n\n");

    buffer = "";               // reset buffer
    next_dump += INTERVAL;     // jadwal dump berikutnya
  }

  // === CODE SELESAI (timeout manual) ===
  if (time &gt;= MAX_TIME) {
    log.log("=== Simulation finished at " + (time/60000).toFixed(2) + " minutes ===\n");
    log.testOK();      // menandakan test selesai sukses
  }
}</script>
      <active>true</active>
    </plugin_config>
    <bounds x="-10" y="172" height="700" width="600" z="6" />
  </plugin>
</simconf>
